/**
 * Utilidades para búsqueda inteligente con tolerancia de acentos,
 * mayúsculas/minúsculas y coincidencias parciales.
 */

import { Garantia, GarantiaLiberada } from '../types';

export type TipoGarantiaVisual = 'Terreno' | 'Bien' | 'Combinado';

/**
 * Obtiene la etiqueta de clasificación VISUAL para la interfaz de usuario:
 * - "Terreno": si la garantía contiene únicamente terrenos / lotes.
 * - "Bien": si la garantía contiene únicamente bienes (vehículos, maquinaria, implementos).
 * - "Combinado": si la garantía contiene al menos un lote Y al menos un bien.
 *
 * NOTA: Esta función es pura y exclusiva para renderizado visual en React.
 * No altera el tipo técnico enviado a Google Apps Script.
 * Utiliza los datos de la garantía ya presentes en memoria sin dependencias circulares ni consultas de red.
 */
export function getTipoGarantiaEtiqueta(garantia?: any): TipoGarantiaVisual {
  if (!garantia) return 'Terreno';

  const lotesArr = Array.isArray(garantia.lotes) ? garantia.lotes : [];
  const bienesArr = Array.isArray(garantia.bienes) ? garantia.bienes : [];

  const cantidadLotes = typeof garantia.cantidadLotes === 'number'
    ? garantia.cantidadLotes
    : Number(garantia.cantidadLotes) || 0;
  const cantidadBienes = typeof garantia.cantidadBienes === 'number'
    ? garantia.cantidadBienes
    : Number(garantia.cantidadBienes) || 0;

  const lotesRes = garantia.lotesResumen !== undefined && garantia.lotesResumen !== null
    ? String(garantia.lotesResumen).trim()
    : '';
  const polizasRes = garantia.polizasResumen !== undefined && garantia.polizasResumen !== null
    ? String(garantia.polizasResumen).trim()
    : '';

  const isResumenValido = (val: string) => {
    if (!val) return false;
    const clean = val.toLowerCase();
    return clean !== '—' && clean !== '-' && clean !== 'n/a' && clean !== 'null' && clean !== 'undefined' && clean !== 'none' && clean !== '0';
  };

  const hasLotes =
    lotesArr.length > 0 ||
    cantidadLotes > 0 ||
    isResumenValido(lotesRes);

  const hasBienes =
    bienesArr.length > 0 ||
    cantidadBienes > 0 ||
    isResumenValido(polizasRes);

  if (hasLotes && hasBienes) {
    return 'Combinado';
  }
  if (hasLotes) {
    return 'Terreno';
  }
  if (hasBienes) {
    return 'Bien';
  }

  // Fallback seguro por tipoGarantia histórico si no hay resumen
  const rawTipo = (garantia.tipoGarantia || '').toString().trim().toLowerCase();
  if (
    rawTipo.includes('combinad') ||
    rawTipo.includes('mixt') ||
    rawTipo.includes('terrenos y bienes') ||
    rawTipo.includes('bienes y terrenos')
  ) {
    return 'Combinado';
  }
  if (
    rawTipo.includes('bien') ||
    rawTipo.includes('vehícul') ||
    rawTipo.includes('vehicul') ||
    rawTipo.includes('maquinari') ||
    rawTipo.includes('implemento')
  ) {
    return 'Bien';
  }

  return 'Terreno';
}

/**
 * Deduplica una lista de garantías asegurando que cada garantía aparezca
 * exactamente una sola vez por su `idGarantia`.
 *
 * REGLAS OBLIGATORIAS:
 * 1. Cada garantía aparece una sola vez por su ID Garantía.
 * 2. Si vienen filas repetidas con el mismo ID Garantía (ej: por relaciones múltiples de lotes/bienes),
 *    se consolidan sus resúmenes y relaciones para no perder datos ni hectáreas/bienes.
 * 3. NO agrupa garantías diferentes solamente porque compartan el mismo N.º Solicitud:
 *    si dos registros tienen IDs de garantía distintos (ej: GAR-001 y GAR-002),
 *    se mantienen como dos filas independientes y legítimas.
 * 4. Pura e inmutable: clona los arreglos para nunca mutar referencias en memoria.
 */
export function deduplicarGarantiasPorId(lista: Garantia[]): Garantia[] {
  if (!Array.isArray(lista) || lista.length === 0) return [];

  const mapById = new Map<string, Garantia>();
  const sinId: Garantia[] = [];

  for (const g of lista) {
    if (!g) continue;
    const rawId = (g.idGarantia !== undefined && g.idGarantia !== null)
      ? String(g.idGarantia).trim()
      : '';
    if (!rawId) {
      sinId.push({ ...g });
      continue;
    }

    const key = rawId.toLowerCase();
    if (!mapById.has(key)) {
      mapById.set(key, {
        ...g,
        lotes: Array.isArray(g.lotes) ? [...g.lotes] : [],
        bienes: Array.isArray(g.bienes) ? [...g.bienes] : [],
      });
    } else {
      const existente = mapById.get(key)!;

      // Consolidar lotes si vienen en arreglos sin mutar original
      if (Array.isArray(g.lotes) && g.lotes.length > 0) {
        existente.lotes = Array.isArray(existente.lotes) ? [...existente.lotes] : [];
        for (const l of g.lotes) {
          if (!l) continue;
          const yaExiste = existente.lotes.some(
            (el) => String(el.idLote || '').trim().toLowerCase() === String(l.idLote || '').trim().toLowerCase() &&
                    String(el.garantiaConTipo || '').trim() === String(l.garantiaConTipo || '').trim()
          );
          if (!yaExiste) existente.lotes.push(l);
        }
      }

      // Consolidar bienes si vienen en arreglos sin mutar original
      if (Array.isArray(g.bienes) && g.bienes.length > 0) {
        existente.bienes = Array.isArray(existente.bienes) ? [...existente.bienes] : [];
        for (const b of g.bienes) {
          if (!b) continue;
          const yaExiste = existente.bienes.some(
            (eb) => String(eb.idBien || '').trim().toLowerCase() === String(b.idBien || '').trim().toLowerCase() &&
                    String(eb.garantiaConTipo || '').trim() === String(b.garantiaConTipo || '').trim()
          );
          if (!yaExiste) existente.bienes.push(b);
        }
      }

      // Consolidar resúmenes de texto de forma ultra segura
      const resLotesG = g.lotesResumen !== undefined && g.lotesResumen !== null ? String(g.lotesResumen).trim() : '';
      const resLotesExt = existente.lotesResumen !== undefined && existente.lotesResumen !== null ? String(existente.lotesResumen).trim() : '';
      if (!resLotesExt && resLotesG) {
        existente.lotesResumen = resLotesG;
      } else if (resLotesExt && resLotesG && !resLotesExt.toLowerCase().includes(resLotesG.toLowerCase())) {
        existente.lotesResumen = `${resLotesExt}, ${resLotesG}`;
      }

      const resPolG = g.polizasResumen !== undefined && g.polizasResumen !== null ? String(g.polizasResumen).trim() : '';
      const resPolExt = existente.polizasResumen !== undefined && existente.polizasResumen !== null ? String(existente.polizasResumen).trim() : '';
      if (!resPolExt && resPolG) {
        existente.polizasResumen = resPolG;
      } else if (resPolExt && resPolG && !resPolExt.toLowerCase().includes(resPolG.toLowerCase())) {
        existente.polizasResumen = `${resPolExt}, ${resPolG}`;
      }

      const resUbicG = g.ubicacionesResumen !== undefined && g.ubicacionesResumen !== null ? String(g.ubicacionesResumen).trim() : '';
      const resUbicExt = existente.ubicacionesResumen !== undefined && existente.ubicacionesResumen !== null ? String(existente.ubicacionesResumen).trim() : '';
      if (!resUbicExt && resUbicG) {
        existente.ubicacionesResumen = resUbicG;
      } else if (resUbicExt && resUbicG && !resUbicExt.toLowerCase().includes(resUbicG.toLowerCase())) {
        existente.ubicacionesResumen = `${resUbicExt}, ${resUbicG}`;
      }

      existente.cantidadLotes = Math.max(
        Number(existente.cantidadLotes) || 0,
        Number(g.cantidadLotes) || 0,
        existente.lotes ? existente.lotes.length : 0
      );
      existente.cantidadBienes = Math.max(
        Number(existente.cantidadBienes) || 0,
        Number(g.cantidadBienes) || 0,
        existente.bienes ? existente.bienes.length : 0
      );

      if (!existente.tipoGarantia && g.tipoGarantia) {
        existente.tipoGarantia = g.tipoGarantia;
      }
    }
  }

  return [...Array.from(mapById.values()), ...sinId];
}

/**
 * Deduplica una lista de garantías liberadas asegurando que cada garantía aparezca
 * exactamente una sola vez por su `idGarantia` (o `idLiberacion`).
 */
export function deduplicarGarantiasLiberadasPorId(lista: GarantiaLiberada[]): GarantiaLiberada[] {
  if (!Array.isArray(lista) || lista.length === 0) return [];

  const mapById = new Map<string, GarantiaLiberada>();
  const sinId: GarantiaLiberada[] = [];

  for (const g of lista) {
    if (!g) continue;
    const rawId = (g.idGarantia !== undefined && g.idGarantia !== null && String(g.idGarantia).trim() !== '')
      ? String(g.idGarantia).trim()
      : (g.idLiberacion !== undefined && g.idLiberacion !== null && String(g.idLiberacion).trim() !== '')
      ? String(g.idLiberacion).trim()
      : '';

    if (!rawId) {
      sinId.push({ ...g });
      continue;
    }

    const key = rawId.toLowerCase();
    if (!mapById.has(key)) {
      mapById.set(key, {
        ...g,
        lotes: Array.isArray(g.lotes) ? [...g.lotes] : [],
        bienes: Array.isArray(g.bienes) ? [...g.bienes] : [],
      });
    } else {
      const existente = mapById.get(key)!;

      if (Array.isArray(g.lotes) && g.lotes.length > 0) {
        existente.lotes = Array.isArray(existente.lotes) ? [...existente.lotes] : [];
        for (const l of g.lotes) {
          if (!l) continue;
          const yaExiste = existente.lotes.some(
            (el) => String(el.idLote || '').trim().toLowerCase() === String(l.idLote || '').trim().toLowerCase()
          );
          if (!yaExiste) existente.lotes.push(l);
        }
      }

      if (Array.isArray(g.bienes) && g.bienes.length > 0) {
        existente.bienes = Array.isArray(existente.bienes) ? [...existente.bienes] : [];
        for (const b of g.bienes) {
          if (!b) continue;
          const yaExiste = existente.bienes.some(
            (eb) => String(eb.idBien || '').trim().toLowerCase() === String(b.idBien || '').trim().toLowerCase()
          );
          if (!yaExiste) existente.bienes.push(b);
        }
      }

      const resLotesG = g.lotesResumen !== undefined && g.lotesResumen !== null ? String(g.lotesResumen).trim() : '';
      const resLotesExt = existente.lotesResumen !== undefined && existente.lotesResumen !== null ? String(existente.lotesResumen).trim() : '';
      if (!resLotesExt && resLotesG) {
        existente.lotesResumen = resLotesG;
      } else if (resLotesExt && resLotesG && !resLotesExt.toLowerCase().includes(resLotesG.toLowerCase())) {
        existente.lotesResumen = `${resLotesExt}, ${resLotesG}`;
      }

      const resPolG = g.polizasResumen !== undefined && g.polizasResumen !== null ? String(g.polizasResumen).trim() : '';
      const resPolExt = existente.polizasResumen !== undefined && existente.polizasResumen !== null ? String(existente.polizasResumen).trim() : '';
      if (!resPolExt && resPolG) {
        existente.polizasResumen = resPolG;
      } else if (resPolExt && resPolG && !resPolExt.toLowerCase().includes(resPolG.toLowerCase())) {
        existente.polizasResumen = `${resPolExt}, ${resPolG}`;
      }

      const resUbicG = g.ubicacionesResumen !== undefined && g.ubicacionesResumen !== null ? String(g.ubicacionesResumen).trim() : '';
      const resUbicExt = existente.ubicacionesResumen !== undefined && existente.ubicacionesResumen !== null ? String(existente.ubicacionesResumen).trim() : '';
      if (!resUbicExt && resUbicG) {
        existente.ubicacionesResumen = resUbicG;
      } else if (resUbicExt && resUbicG && !resUbicExt.toLowerCase().includes(resUbicG.toLowerCase())) {
        existente.ubicacionesResumen = `${resUbicExt}, ${resUbicG}`;
      }

      existente.cantidadLotes = Math.max(
        Number(existente.cantidadLotes) || 0,
        Number(g.cantidadLotes) || 0,
        existente.lotes ? existente.lotes.length : 0
      );
      existente.cantidadBienes = Math.max(
        Number(existente.cantidadBienes) || 0,
        Number(g.cantidadBienes) || 0,
        existente.bienes ? existente.bienes.length : 0
      );

      if (!existente.tipoGarantia && g.tipoGarantia) {
        existente.tipoGarantia = g.tipoGarantia;
      }
    }
  }

  return [...Array.from(mapById.values()), ...sinId];
}

/**
 * Normaliza un texto para búsqueda:
 * Convierte a minúsculas y elimina diacríticos/acentos (á -> a, é -> e, etc.)
 */
export function normalizeText(text: string | number | null | undefined): string {
  if (text === null || text === undefined) return '';
  return String(text)
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim();
}

/**
 * Comprueba si un texto objetivo coincide con el término de búsqueda.
 */
export function matchesQuery(target: string | number | null | undefined, query: string): boolean {
  if (!query) return true;
  const cleanTarget = normalizeText(target);
  const cleanQuery = normalizeText(query);
  return cleanTarget.includes(cleanQuery);
}

/**
 * Comprueba si alguna propiedad de un objeto coincide con el término de búsqueda.
 */
export function matchesAnyField<T extends Record<string, any>>(item: T, fields: (keyof T)[], query: string): boolean {
  if (!query || !query.trim()) return true;
  const cleanQuery = normalizeText(query);
  return fields.some((field) => {
    const val = item[field];
    return normalizeText(val).includes(cleanQuery);
  });
}

/**
 * Formatea la etiqueta de cliente según la norma de la aplicación:
 * "Cuenta — Nombre"
 */
export function formatClienteLabel(cuenta: string | number, nombre: string): string {
  return `${cuenta} — ${nombre}`;
}

/**
 * Formatea la etiqueta de propietario para terrenos y bienes:
 * "Nombre (Cuenta XXX)" según requisito oficial.
 * Ej: "Klas Rempel (Cuenta 100)"
 */
export function formatPropietario(propietario?: string, cuenta?: string | number): string {
  const nombre = (propietario || '').trim();
  const cta =
    cuenta !== undefined && cuenta !== null && String(cuenta).trim() !== ''
      ? String(cuenta).trim()
      : '';

  if (nombre && cta) {
    return `${nombre} (Cuenta ${cta})`;
  }
  if (nombre) return nombre;
  if (cta) return `Cuenta ${cta}`;
  return '—';
}

/**
 * Formato numérico para hectáreas con hasta 6 decimales reales sin ceros innecesarios al final
 * Ejemplos: 11.4336 -> "11,4336 ha", 50 -> "50 ha", 0.000125 -> "0,000125 ha"
 */
export function formatHectareas(num: number | null | undefined): string {
  if (num === null || num === undefined || isNaN(Number(num))) return '—';
  const val = Number(num);
  return `${val.toLocaleString('es-BO', { minimumFractionDigits: 0, maximumFractionDigits: 6 })} ha`;
}

/**
 * Parsea un valor numérico decimal admitiendo coma y punto, manteniendo hasta 6 decimales
 */
export function parseDecimal(val: any): number {
  if (val === null || val === undefined) return 0;
  if (typeof val === 'number') return isNaN(val) ? 0 : val;
  const str = String(val).trim().replace(',', '.');
  const num = parseFloat(str);
  return isNaN(num) ? 0 : num;
}

/**
 * Formato de fecha estándar DD/MM/AAAA
 */
export function formatFecha(fechaStr: string | null | undefined): string {
  if (!fechaStr || fechaStr === '—' || String(fechaStr).trim() === '') return '—';
  const cleanDate = String(fechaStr).split('T')[0].split(' ')[0].trim();
  if (cleanDate.includes('-')) {
    const parts = cleanDate.split('-');
    if (parts.length === 3) {
      return `${parts[2].slice(0, 2)}/${parts[1]}/${parts[0]}`;
    }
  }
  if (cleanDate.includes('/')) {
    const parts = cleanDate.split('/');
    if (parts.length === 3) {
      if (parts[0].length === 4) {
        return `${parts[2]}/${parts[1]}/${parts[0]}`;
      }
      return cleanDate;
    }
  }
  return cleanDate;
}

/**
 * Obtiene la fecha actual en formato ISO AAAA-MM-DD
 */
export function getTodayIso(): string {
  const now = new Date();
  const year = now.getFullYear();
  const month = String(now.getMonth() + 1).padStart(2, '0');
  const day = String(now.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;
}

/**
 * Calcula el estado de vencimiento según la regla de la institución y backend:
 * - 'Sin vencimiento' si no tiene fecha
 * - 'Vencida' si la fecha ya pasó (< 0 días)
 * - 'Próxima a vencer' si vence dentro de los próximos 30 días (0 a 30 días)
 * - 'Vigente' si faltan más de 30 días
 */
export function calcularEstadoVencimiento(fechaVencimientoStr?: string | null): {
  estado: 'Vigente' | 'Próxima a vencer' | 'Vencida' | 'Sin vencimiento';
  diasRestantes?: number;
} {
  if (!fechaVencimientoStr || !fechaVencimientoStr.trim() || fechaVencimientoStr === '—') {
    return { estado: 'Sin vencimiento' };
  }

  let y = 0,
    m = 0,
    d = 0;
  if (fechaVencimientoStr.includes('-')) {
    const parts = fechaVencimientoStr.split('-').map(Number);
    y = parts[0];
    m = parts[1] - 1;
    d = parts[2];
  } else if (fechaVencimientoStr.includes('/')) {
    const parts = fechaVencimientoStr.split('/').map(Number);
    d = parts[0];
    m = parts[1] - 1;
    y = parts[2];
  } else {
    return { estado: 'Sin vencimiento' };
  }

  if (isNaN(y) || isNaN(m) || isNaN(d) || y <= 0 || d <= 0) {
    return { estado: 'Sin vencimiento' };
  }

  const targetDate = new Date(y, m, d);
  const now = new Date();
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());

  const diffMs = targetDate.getTime() - today.getTime();
  const diasRestantes = Math.ceil(diffMs / (1000 * 60 * 60 * 24));

  if (diasRestantes < 0) {
    return { estado: 'Vencida', diasRestantes };
  } else if (diasRestantes <= 30) {
    return { estado: 'Próxima a vencer', diasRestantes };
  } else {
    return { estado: 'Vigente', diasRestantes };
  }
}
